{
  // Static site plus one small Worker script. Cloudflare serves everything
  // under `assets.directory` directly; only paths listed in `run_worker_first`
  // (the Instagram feed at /api/instagram) run src/worker.js. Assets are the
  // Workers equivalent of the "Build output directory" that Pages projects have.
  "name": "bahiamovement",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Serves /costa-combat/promos/a/ from .../a/index.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Weekly, Monday 09:00 UTC: refresh the Instagram token (60-day lifetime).
  "triggers": {
    "crons": ["0 9 * * 1"]
  },
  // Optional, for the token refresh to stick — see README → Instagram feed.
  // "kv_namespaces": [{ "binding": "IG_KV", "id": "<namespace id>" }],
  "observability": {
    "enabled": true
  }
}
